# Required — get your API key from your Zernio dashboard (https://zernio.com)
ZERNIO_API_KEY=

# Optional — defaults to https://zernio.com/api
# ZERNIO_API_URL=

# Forward inbound WhatsApp → FastAPI do agente (mesma chave do .env da raiz)
# Local: http://127.0.0.1:8000
# Produção (inbox.infinityai.com.br): https://api.harmostore.infinityai.com.br
HARMOSTORE_API_URL=http://127.0.0.1:8000
HARMOSTORE_API_KEY=

# Optional — set to 'true' to enable the WhatsApp Business Calling dial pad
# NEXT_PUBLIC_WHATSAPP_CALLING_ENABLED=
